NODE_ENV=development
PORT=4100
HOST=0.0.0.0

# Lokal (docker-compose.yml):
MONGODB_URI=mongodb://127.0.0.1:27017/lokma_toyxonalar

# Production (docker-compose.prod.yml) — MONGODB_URI shulardan yig'iladi:
# MONGO_ROOT_USER=lokma
# MONGO_ROOT_PASSWORD=<uzun-tasodifiy-parol>

# Vergul bilan (web / Telegram Mini App domenlari). Mobil ilovaga CORS kerak emas.
# Bo'sh: dev'da hammasiga ruxsat, production'da brauzerlarga yopiq.
CORS_ORIGINS=

# openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=30d

# Telegram Mini App initData tekshiruvi (@BotFather tokeni)
TELEGRAM_BOT_TOKEN=

# Admin API: "X-Admin-Key: <kalit>" sarlavhasi, kamida 24 belgi. openssl rand -hex 24
ADMIN_API_KEY=

# Bron qilinganda seans necha daqiqa ushlab turiladi
HOLD_MINUTES=30
TZ_NAME=Asia/Tashkent

# true = Telegram'siz (oddiy mobil ilova) ham bron qilish mumkin
ALLOW_ANONYMOUS_BOOKING=true
BOOKING_RATE_LIMIT=10
API_RATE_LIMIT=300

# ── To'yxona egasi / xodim mobil ilovasi ──
OWNER_TOKEN_EXPIRES_IN=30d

# Cloudinary (rasmlar). https://console.cloudinary.com → Settings → API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=lokma-toyxonalar
CLOUDINARY_VERIFY=auto

# SMS (parolni tiklash kodi). none = faqat dev (kod logga yoziladi)
SMS_PROVIDER=none
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546
# SMS_TEMPLATE=Lokma To'yxonalar: tasdiqlash kodi {code}. Uni hech kimga bermang.

# Demo hisoblar (npm run seed): production'da faqat SEED_DEMO_ACCOUNTS=true bo'lsa yaratiladi
# SEED_DEMO_ACCOUNTS=false
